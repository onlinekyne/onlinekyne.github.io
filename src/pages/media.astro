---
import BaseHead from '../components/BaseHead.astro'; import Header from '../components/Header.astro'; import Footer from '../components/Footer.astro'; import { SITE_TITLE } from '../consts';
---
<!doctype html><html lang="en"><head><BaseHead title={`Writing & Media | ${SITE_TITLE}`} description="Writing, video, and podcast work by Kyne Santos." /></head><body><Header /><main><p class="eyebrow">Public work</p><h1>Writing & media</h1><div class="items"><article><h2>Substack</h2><p>Essays about mathematics, technology, and life.</p><a href="https://onlinekyne.substack.com/">Read the blog →</a></article><article><h2>Video</h2><p>Educational videos about math, science, history, and drag.</p><a href="https://www.youtube.com/@onlinekyne">Watch on YouTube →</a></article><article><h2>Think Queen with Kyne</h2><p>A podcast featuring conversations with scientists, historians, linguists, and other fascinating people.</p><a href="https://open.spotify.com/show/6o26mNVCXr6iJCyzo2jxkn">Listen on Spotify →</a></article></div></main><Footer /></body></html>
<style>.eyebrow{color:var(--color-accent);font-size:.8rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase}.items{border-top:1px solid var(--color-border);margin-top:2.5rem}.items article{border-bottom:1px solid var(--color-border);padding:1.8rem 0}.items h2{border:0;display:block;margin:0;padding:0}</style>
