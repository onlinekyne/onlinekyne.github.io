---
import BaseHead from '../components/BaseHead.astro'; import Header from '../components/Header.astro'; import Footer from '../components/Footer.astro'; import { SITE_TITLE } from '../consts';
---
<!doctype html><html lang="en"><head><BaseHead title={`Research | ${SITE_TITLE}`} description="Research interests and projects by Kyne Santos." /></head><body><Header /><main><p class="eyebrow">Research</p><h1>Mathematics in context</h1><p class="intro">Kyne is interested in the ways mathematical ideas move through technology, culture, education, and public life.</p><div class="grid"><section><h2>Research interests</h2><ul><li>Networks and graph theory</li><li>Computer science and technology</li><li>Mathematics education</li><li>History and foundations of mathematics</li></ul></section><section><h2>Projects</h2><h3>Two-Step Flow Model</h3><p>An exploratory model connecting ideas about information flow and social networks.</p><a href="/files/TwoStepFlowModel.html">Explore the project →</a><h3>Public mathematics</h3><p>Kyne develops accessible work on mathematical ideas through video, writing, performance, and conversation.</p></section></div></main><Footer /></body></html>
<style>.eyebrow{color:var(--color-accent);font-size:.8rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase}.intro{font-family:var(--font-serif);font-size:1.4rem;max-width:44rem}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:4rem;margin-top:3rem}.grid section+section{border-left:1px solid var(--color-border);padding-left:3rem}li{margin:.6rem 0}@media(max-width:700px){.grid{grid-template-columns:1fr}.grid section+section{border:0;border-top:1px solid var(--color-border);padding:2rem 0 0}}</style>
