---
import BaseHead from '../components/BaseHead.astro'; import Header from '../components/Header.astro'; import Footer from '../components/Footer.astro'; import { SITE_TITLE } from '../consts';
---
<!doctype html><html lang="en"><head><BaseHead title={`Contact | ${SITE_TITLE}`} description="Contact Kyne Santos for bookings, press, and general inquiries." /></head><body><Header /><main><p class="eyebrow">Contact</p><h1>Get in touch</h1><div class="grid"><section><h2>Bookings & business</h2><p>For speaking, appearances, and business inquiries, contact <a href="mailto:daniel@talenthouse.ca">daniel@talenthouse.ca</a>.</p></section><section><h2>Press & general inquiries</h2><p>For press and general inquiries, contact <a href="mailto:onlinekyne@gmail.com">onlinekyne@gmail.com</a>.</p></section></div></main><Footer /></body></html>
<style>.eyebrow{color:var(--color-accent);font-size:.8rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase}.grid{display:grid;grid-template-columns:1fr 1fr;gap:3rem;margin-top:3rem}.grid section+section{border-left:1px solid var(--color-border);padding-left:3rem}.grid h2{border:0;display:block;padding:0;margin:0 0 .6rem}@media(max-width:700px){.grid{grid-template-columns:1fr}.grid section+section{border:0;border-top:1px solid var(--color-border);padding:2rem 0 0}}</style>
