---
import BaseHead from '../components/BaseHead.astro'; import Header from '../components/Header.astro'; import Footer from '../components/Footer.astro'; import { SITE_TITLE } from '../consts';
---
<!doctype html><html lang="en"><head><BaseHead title={`Math In Drag | ${SITE_TITLE}`} description="Math In Drag by Kyne Santos." image="/math-in-drag-cover.jpeg" /></head><body><Header /><main><section class="book"><img src="/math-in-drag-cover.jpeg" alt="Math In Drag book cover" /><div><p class="eyebrow">Book</p><h1><em>Math In Drag</em></h1><p class="intro">A journey through mathematics, drag, history, and the beauty of asking better questions.</p><p>In <em>Math In Drag</em>, Kyne Santos explores the surprising connections between mathematical mysteries and the world of drag—with irreverence, curiosity, and a belief that math belongs to everyone.</p><p><strong>Published March 5, 2024</strong><br />ISBN 978-1421448749</p><a class="btn" href="https://www.press.jhu.edu/books/title/12813/math-drag">Buy from the publisher</a></div></section></main><Footer /></body></html>
<style>.book{display:grid;grid-template-columns:minmax(180px,280px) 1fr;gap:4rem;align-items:start;padding:2rem 0}.book img{width:100%;box-shadow:var(--shadow-lg)}.eyebrow{color:var(--color-accent);font-size:.8rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase}.intro{font-family:var(--font-serif);font-size:1.45rem;color:var(--color-text-main)}@media(max-width:700px){.book{grid-template-columns:1fr;gap:2rem}.book img{max-width:240px}}</style>
