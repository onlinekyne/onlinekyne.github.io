---
import BaseHead from '../components/BaseHead.astro'; import Header from '../components/Header.astro'; import Footer from '../components/Footer.astro'; import { SITE_TITLE } from '../consts';
const items = [
  ['2025', 'Attitude', 'Here are the 101 influential figures who made our list', 'https://www.attitude.co.uk/life/attitude-101-2025-full-list-479582/'],
  ['2025', 'Stony Brook Press', "The drag queen-math educator who’s anything but derivative", 'https://sbpress.com/2025/01/kyne-santos-the-drag-queen-math-educator-whos-anything-but-derivative/'],
  ['2024', 'National Academies', '2024 recipients of the Eric and Wendy Schmidt Awards for Excellence in Science Communications', 'https://www.nationalacademies.org/news/2024/10/national-academies-announce-2024-recipients-of-eric-and-wendy-schmidt-awards-for-excellence-in-science-communications'],
  ['2024', 'NPR', "Drag queen Kyne Santos explores how math is ‘beautiful’ in new book ‘Math in Drag’", 'https://www.npr.org/2024/06/07/1198910152/math-drag-queen-kyne-santos-tiktok'],
  ['2024', 'Scientific American', 'Finding Math’s Beauty and Power with Drag Queen Kyne Santos', 'https://www.scientificamerican.com/podcast/episode/discover-maths-elegance-and-power-with-drag-queen-kyne-santos/'],
];
---
<!doctype html><html lang="en"><head><BaseHead title={`Press & Awards | ${SITE_TITLE}`} description="Press and recognition for Kyne Santos." /></head><body><Header /><main><p class="eyebrow">Recognition</p><h1>Press & awards</h1><p class="intro">Selected coverage and recognition for Kyne’s work in mathematics and science communication.</p><div class="list">{items.map(([year, publication, title, href]) => <article><span>{year}</span><div><p>{publication}</p><a href={href}>{title} →</a></div></article>)}</div></main><Footer /></body></html>
<style>.eyebrow{color:var(--color-accent);font-size:.8rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase}.intro{font-family:var(--font-serif);font-size:1.35rem}.list{margin-top:2rem;border-top:1px solid var(--color-border)}.list article{display:grid;grid-template-columns:5rem 1fr;gap:1rem;border-bottom:1px solid var(--color-border);padding:1.25rem 0}.list p{margin:0 0 .25rem;font-size:.9rem;text-transform:uppercase;letter-spacing:.05em}@media(max-width:500px){.list article{grid-template-columns:1fr;gap:.25rem}}</style>
